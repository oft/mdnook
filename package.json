{
  "name": "mdnook-workspace",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/oft/mdnook.git" },
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p packages/server/tsconfig.json && tsc -p packages/cli/tsconfig.json && vue-tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:cli": "pnpm build && pnpm --dir packages/cli pack --pack-destination ../../artifacts",
    "pack:check": "node scripts/pack-check.mjs",
    "release:prepare": "pnpm typecheck && pnpm test && pnpm pack:cli && pnpm pack:check",
    "release:dry-run": "pnpm release:prepare && node scripts/publish.mjs --dry-run",
    "release:npm": "pnpm release:prepare && node scripts/publish.mjs",
    "release:tag-check": "node scripts/check-release-tag.mjs",
    "release:verify": "node scripts/verify-publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.12"
  }
}
